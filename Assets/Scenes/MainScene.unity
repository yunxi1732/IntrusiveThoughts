      m_Calls: []
  m_text: "\u84DD\u8272\u7684\u62E8\u7247\uFF0C\u770B\u4F3C\u5C0F\u5C0F\u4E00\u7247\uFF0C\u5176\u5B9E\u662F\u82B1\u6389\u4E86\u6211\u5F53\u65F6\u4E00\u4E2A\u661F\u671F\u4F19\u98DF\u8D39\u7684\u9650\u5B9A\u6B3E\u5F0F\uFF0C\u8D34\u4E0A\u4E86\u9EBB\u96C0\u5236\u4F5C\u7684\u201C\u864E\u5934\u9CB8\u201D\u8D34\u7EB8\u3002\n\u5E95\u90E8\u6709\u201CTry
    Hard\u201D\u5B57\u6837\uFF0C\u5305\u542B\u7740\u8BBE\u8BA1\u5E08\u7684\u5DE7\u601D\uFF0C\u53EA\u8981\u52E4\u52A0\u7EC3\u4E60\u5C31\u80FD\u901A\u8FC7\u5851\u6599\u78E8\u635F\u5448\u73B0\u51FA\u96EA\u5C71\u666F\u8C61\u3002\n
    \u201C\u6216\u8BB8\u5148\u627E\u4EFD\u6B63\u7ECF\u5DE5\u4F5C\uFF0C\u8FD9\u4E2A\u5C31\u4F5C\u4E3A\u7231\u597D\u5427\uFF1F\u201D
    \u201C\u4E2D\u8003\u5B8C\u5C31\u81EA\u7531\u4E86\u3002\u201D  \u201C\u9AD8\u8003\u5B8C\u5C31\u81EA\u7531\u4E86\u3002\u201D
    \n \u201C\u53CD\u6B63\u70ED\u5EA6\u4E5F\u5C31\u90A3\u6837\u3002\u201D \u201C\u5927\u5B66\u6BD5\u4E1A\u5C31\u53EF\u4EE5\u968F\u4F60\u600E\u6837\u4E86\u3002\u201D\u201C\u627E\u5230\u5DE5\u4F5C\u5C31\u5F00\u542F\u65B0\u751F\u6D3B\u5427\u3002\u201D
    \n\u597D\u7684\u3001\u6CA1\u95EE\u9898\u3001\u6211\u77E5\u9053\u4E86\u3002\u6BD5\u7ADF\u6211\u4E0D\u4F1A\u7ED9\u4EFB\u4F55\u4EBA\u6DFB\u9EBB\u70E6\u3002\u8BDD\u867D\u5982\u6B64\uFF0C\u5728\u76AE\u5F00\u8089\u7EFD\u7684\u84DD\u8272\u4E4B\u4E2D\uFF0C\u65F6\u95F4\u7684\u75D5\u8FF9\u503E\u6CFB\u800C\u4E0B\u3002\n\n\u8BF4\u8D77\u6765\uFF0C\u9EBB\u96C0\u662F\u5728\u9AD8\u4E09\u4E0A\u5B66\u671F\u7684\u4E00\u4E2A\u5348\u540E\u544A\u8BC9\u6211\u201C\u4E0D\u4F1A\u518D\u8BFB\u4E66\u4E86\u201D\u7684\u3002\n\n\u201C\u8FD8\u80FD\u60F3\u60F3\u529E\u6CD5\u5427\uFF1F\u81F3\u5C11\u548C\u8001\u5E08\u8C08\u8C08\uFF0C\u7533\u8BF7\u5B66\u751F\u8D37\u6B3E\u4E4B\u7C7B\u7684\u2026\u2026\u201D\n\u201C\u4E0D\uFF0C\u201D\u90A3\u65F6\u5979\u8BF4\uFF0C\u201C\u6CA1\u5FC5\u8981\u4E86\u3002\u6211\u4F1A\u9760\u81EA\u5DF1\u552F\u4E00\u8981\u505A\u7684\u4E8B\u60C5\u6D3B\u4E0B\u53BB\u3002\u201D\n\u201C\u81F3\u5C11\u8981\u62FF\u5230\u6BD5\u4E1A\u8BC1\uFF0C\u7ED9\u81EA\u5DF1\u7559\u70B9\u540E\u8DEF\u5427\u3002\u201D\n\u201C\u8001\u9C7C\u4F60\u9519\u4E86\uFF0C\u8FD9\u4E16\u4E0A\u6839\u672C\u6CA1\u6709\u771F\u6B63\u7684\u540E\u8DEF\u3002\u201D\n\n\u631A\u53CB\u7626\u524A\u7684\u5F71\u5B50\u5EF6\u4F38\u5230\u6559\u5BA4\u95E8\u5916\uFF0C\u6211\u5DF2\u8BB0\u4E0D\u6E05\u5979\u6700\u540E\u5411\u6211\u95EE\u8BDD\u7684\u8868\u60C5\u3002\n\n\u201C\u4F60\u5462\uFF0C\u8981\u600E\u4E48\u529E\uFF1F\u8981\u548C\u6211\u4E00\u8D77\u505A\u70B9\u4EC0\u4E48\u81EA\u5DF1\u7684\u4E1C\u897F\uFF0C\u5C31\u8D81\u73B0\u5728\u5594\u3002\u201D\n\u201C\u2026\u2026\u201D
    \n\n\u663E\u7136\uFF0C\u4EBA\u7C7B\u6709\u7740\u53EF\u4EE5\u5F39\u594F\u4E50\u5668\u7684\u53CC\u624B\uFF0C\u4F46\u9C7C\u9CCD\u4E0D\u884C\u3002\n\u4EBA\u7C7B\u8FD8\u62E5\u6709\u53EF\u4EE5\u6500\u767B\u9AD8\u5CF0\u7684\u53CC\u624B\u548C\u53CC\u8DB3\uFF0C\u800C\u9C7C\u2026\u2026\u4E0D\uFF0C\u4E5F\u8BB8\u53EF\u4EE5\u627E\u5230\u54EA\u7247\u878D\u5316\u7684\u51B0\u5DDD\u9006\u6D41\u800C\u4E0A\uFF0C\u8DF3\u8FC7\u79EF\u96EA\u7684\u5C71\u5DC5\u5427\u3002\n\u5373\u4F7F\u662F\u8F6C\u751F\u4E3A\u6CA1\u6709\u58F0\u5E26\u7684\u7269\u79CD\uFF0C\u4E5F\u60F3\u65E0\u58F0\u5730\u5927\u543C\u5927\u53EB\u7740\u53D1\u6CC4\u8FD9\u4EFD\u3010\u53EA\u5C5E\u4E8E\u81EA\u5DF1\u7684\u4E0D\u7518\u3011\u3002\n\u4F7F\u7528\u6C34\u6E85\u8DC3\u5427\uFF01\uFF01"
