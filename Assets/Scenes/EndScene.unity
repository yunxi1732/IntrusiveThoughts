  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u6211\u4EEC\u5C06\u201C\u6D8C\u73B0\u201D\u4E4B\u529B\u7684\u653B\u51FB\u6027\u53D1\u6325\u5230\u4E86\u6781\u81F4\u2014\u2014\u8BDA\u5982\u65E0\u5E38\u6240\u8A00\uFF0C\u6211\u5E76\u4E0D\u4F1A\u56E0\u4E3A\u8FD9\u4E9B\u884C\u4E3A\u906D\u5230\u60E9\u7F5A\u3002\u4F55\u51B5\uFF0C\u6211\u6240\u505A\u7684\u53EA\u4E0D\u8FC7\u662F\u4EBA\u4E4B\u5E38\u60C5\uFF0C\u4E0D\u662F\u5417\uFF1F\n\u4E0D\u77E5\u4F55\u65F6\uFF0C\u8857\u5934\u5DF7\u5C3E\u6D41\u884C\u8D77\u4E86\u5173\u4E8E\u6211\u60E8\u6B7B\u5728\u8F66\u7978\u4E2D\u4EE5\u540E\u5316\u4F5C\u5389\u9B3C\u7684\u4F20\u8A00\u3002\u6709\u7075\u5F02\u63A2\u9669\u535A\u4E3B\u5728\u8FD9\u4E03\u5929\u7684\u534A\u591C\u5230\u6211\u51FA\u4E8B\u7684\u8DEF\u53E3\u63A2\u79D8\uFF0C\u6211\u5076\u5C14\u4E5F\u4F1A\u6EE1\u8DB3\u4E00\u4E0B\u4ED6\u4EEC\uFF0C\u968F\u624B\u4ECE\u6211\u7684\u9057\u7269\u91CC\u5438\u53D6\u4E00\u4E9B\u4E0D\u90A3\u4E48\u6109\u5FEB\u7684\u56DE\u5FC6\uFF0C\u5728\u4ED6\u4EEC\u6218\u6218\u5162\u5162\u7684\u65F6\u5019\u7A81\u7136\u6D8C\u73B0\u2014\u2014\u8FD9\u592A\u7B80\u5355\u4E86\uFF0C\u4EBA\u5728\u786C\u6491\u7684\u65F6\u5019\u601D\u7EF4\u7834\u7EFD\u6700\u5927\uFF0C\u6211\u65E9\u5DF2\u8FD0\u7528\u81EA\u5982\u3002\u76F4\u5230\u6709\u4EBA\u56E0\u4E3A\u60CA\u5413\u800C\u5931\u8DB3\u6389\u8FDB\u4E0B\u6C34\u4E95\uFF0C\u6211\u4E5F\u6CA1\u6709\u4ED8\u51FA\u4EFB\u4F55\u4EE3\u4EF7\u3002\n\u6BD5\u7ADF\uFF0C\u90A3\u8BF8\u591A\u4FC3\u6210\u6211\u8FD9\u60E8\u6DE1\u4E00\u751F\u7684\u4EBA\u548C\u4E8B\u7269\uFF0C\u53C8\u4ED8\u51FA\u8FC7\u4EC0\u4E48\u4EE3\u4EF7\u5462\uFF1F\n\u770B\u6765\u8FD9\u4E2A\u4E16\u754C\u7684\u5929\u5EAD\u975E\u5E38\u6709\u539F\u5219\uFF0C\u5373\u4F7F\u6211\u540E\u6765\u4E58\u7740\u8FD9\u79CD\u4F20\u8A00\u5C06\u95F9\u5267\u6108\u6F14\u6108\u70C8\uFF0C\u4ECE\u523A\u6FC0\u6ECB\u6270\u8FC7\u6211\u7684\u4EBA\u3001\u6211\u8BA8\u538C\u7684\u4EBA\u53D1\u5C55\u5230\u8DEF\u4EBA\uFF0C\u90FD\u6CA1\u6709\u9B3C\u5DEE\u6765\u5BF9\u6211\u63D0\u51FA\u534A\u4E2A\u5B57\u7684\u610F\u89C1\u3002\n\u9EBB\u96C0\u8BF4\u5F97\u5BF9\uFF0C\u51E1\u4E8B\u6709\u673A\u4F1A\u7684\u65F6\u5019\u5C31\u8981\u7269\u5C3D\u5176\u7528\u3002\u6211\u5F00\u59CB\u559C\u6B22\u4E0A\u8FD9\u9879\u80FD\u529B\u4E86\u3002\n\u65E0\u5E38\u6765\u63A5\u6211\u7684\u65F6\u5019\u9732\u51FA\u4E86\u610F\u5473\u6DF1\u957F\u7684\u7B11\u5BB9\u2014\u2014\u6211\u624D\u77E5\u9053\u539F\u6765\u4E4C\u9E26\u662F\u4F1A\u7B11\u7684\u2014\u2014\u6211\u5728\u5199\u5B57\u697C\u7684\u843D\u5730\u7A97\u4E0A\u7167\u4E86\u7167\u81EA\u5DF1\uFF0C\u51E0\u4E4E\u8BA4\u4E0D\u51FA\u5176\u4E2D\u7684\u6A21\u6837\u3002\n\u554A\uFF0C\u201C\u4F59\u4E88\u201D\u957F\u6210\u4EC0\u4E48\u6837\uFF0C\u91CD\u8981\u5417\uFF1F\u6211\u90FD\u8981\u6D88\u5931\u4E86\u3002\n\n\u2026\u2026\u54E6\uFF0C\u6211\u5F53\u7136\u662F\u201C\u4F60\u201D\u3002\u6211\u4EEC\u672C\u6765\u5C31\u662F\u4E00\u4F53\uFF0C\u5BF9\u4E0D\u5BF9\uFF1F\n"
